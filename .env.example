# Copy this file to .env and fill in real values.
# .env is gitignored - never commit your actual keys.

# Google Gemini API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Gemini model to use for job analysis / resume customization
GEMINI_MODEL=gemini-2.0-flash

# Hours before a seen-but-not-applied-to job post can be reconsidered
RECONSIDER_AFTER_HOURS=48

# Minimum AI match score (0-100) required to be eligible for application
MIN_MATCH_SCORE=1

# Only consider LinkedIn posts from the last N hours
JOB_POST_MAX_AGE_HOURS=24

# Dashboard API
API_HOST=127.0.0.1
API_PORT=8000
CORS_ALLOW_ORIGINS=*
LOG_LEVEL=INFO
